# Copy to .env.local. With VITE_USE_EMULATORS=true the app talks to the local emulators.
VITE_USE_EMULATORS=true
VITE_FIREBASE_API_KEY=fake-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-qr-menu.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-qr-menu
VITE_FIREBASE_APP_ID=
# Where the customer menu is served (used inside the printed QR codes).
VITE_MENU_BASE_URL=http://localhost:5173

# Optional: item photos on Cloudinary (free). See docs/DEPLOY.md.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
