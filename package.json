{
  "name": "qr-menu",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @qr-menu/shared && npm run build -w dashboard && npm run build -w menu",
    "typecheck": "tsc -p packages/shared && tsc -p tests --noEmit && tsc -p scripts --noEmit",
    "test": "vitest run --project shared",
    "test:rules": "firebase emulators:exec --only firestore --project demo-qr-menu \"vitest run --project rules\"",
    "emulators": "firebase emulators:start --project demo-qr-menu",
    "seed": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 tsx scripts/seed.ts",
    "dev:dashboard": "npm run dev -w dashboard",
    "dev:menu": "npm run dev -w menu",
    "create-restaurant": "tsx scripts/create-restaurant.ts",
    "set-subscription": "tsx scripts/set-subscription.ts"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.10.0",
    "firebase-admin": "^13.4.0",
    "firebase-tools": "^14.27.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
